# ══════════════════════════════════════════════════════════════
#  VIT AUTO — Variables d'environnement frontend (Vite)
#  cp .env.example .env  puis remplissez les valeurs
#  Toutes les variables lues côté navigateur DOIVENT être préfixées VITE_
#  (voir https://vitejs.dev/guide/env-and-mode.html) — jamais de secret ici,
#  ce fichier finit dans le bundle JS envoyé au client.
# ══════════════════════════════════════════════════════════════

# URL de base de l'API backend. Vide en dev (le proxy Vite redirige /api vers
# le serveur local, voir vite.config.js) ; à renseigner en production si le
# frontend et le backend ne partagent pas le même domaine.
VITE_API_URL=

# Connexion Google (bouton "Se connecter avec Google") — Client ID OAuth
# "Web application" créé sur https://console.cloud.google.com/apis/credentials.
# Identifiant public (pas un secret) ; même valeur que GOOGLE_OAUTH_CLIENT_ID
# côté serveur.
VITE_GOOGLE_CLIENT_ID=

# Sentry (suivi d'erreurs frontend) — DSN public, optionnel.
VITE_SENTRY_DSN=
