# ══════════════════════════════════════════════════════════════
#  VIT AUTO — Variables d'environnement serveur
#  cp .env.example .env  puis remplissez les valeurs
# ══════════════════════════════════════════════════════════════

# ── Base de données MongoDB ──────────────────────────────────
# Format Atlas : mongodb+srv://USER:PASS@cluster.mongodb.net/vit-auto
# MONGO_URI est le nom historique ; MONGODB_URI est lu en priorité par
# server/db/index.js (l'un des deux suffit, MONGO_URI en repli).
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/vit-auto?retryWrites=true&w=majority
# MONGODB_URI=

# ── Sécurité JWT ─────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REMPLACEZ_PAR_UNE_CLE_FORTE_64_CHARS_MINIMUM

# OBLIGATOIRE pour le refresh token — clé DIFFÉRENTE de JWT_SECRET
REFRESH_TOKEN_SECRET=REMPLACEZ_PAR_UNE_DEUXIEME_CLE_FORTE_64_CHARS

# OBLIGATOIRE — chiffrement des champs sensibles (KYC, données personnelles).
# 32 octets en hexadécimal (64 caractères). Générer :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=REMPLACEZ_PAR_32_OCTETS_HEX_64_CHARS

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
# URL publique de CE backend (webhooks paiement, tracking email) — distincte
# d'APP_URL en production (ex: api.vit-auto.com vs vit-auto.com). Retombe sur
# APP_URL si absente.
API_URL=

# Active la vérification d'e-mail obligatoire avant connexion (voir
# emailVerificationRequired.js) — laisser vide/false tant que l'envoi d'email
# n'est pas fiable en production.
REQUIRE_EMAIL_VERIFICATION=false

# ── Serveur ──────────────────────────────────────────────────
PORT=5001
NODE_ENV=development   # production | development

# ── Redis / BullMQ (files d'attente : emails, KYC, PDF, import flotte) ──
# Sans REDIS_URL, les jobs s'exécutent via un fallback synchrone en mémoire
# (voir queue/index.js, SYNC_FALLBACK_LOADERS) — fonctionnel mais sans
# retry/persistance ; fortement recommandé en production pour la fiabilité.
REDIS_URL=

# ── Sentry (suivi d'erreurs) ────────────────────────────────────
SENTRY_DSN=

# ── Email — CAS B : Resend (priorité) → SMTP → Console ──────
# Resend (RECOMMANDÉ) : créer un compte sur resend.com, vérifier votre domaine
# (Domains > Add Domain, puis ajouter les enregistrements SPF/DKIM/DMARC
# fournis chez votre registrar DNS — SANS ce domaine "Verified", Resend
# refuse ou fait bouncer une grande partie des envois vers Gmail/Outlook/etc.,
# cause la plus probable d'emails "not delivered") puis coller votre clé API
# ci-dessous. RESEND_API_KEY a priorité sur SMTP.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=VIT AUTO <noreply@vit-auto.com>

# Adresse recevant une copie email de TOUTE notification admin (KYC soumis,
# litige, rapport, partenaire à examiner...) en plus de la cloche in-app —
# voir models/Notification.js (hook post-save). Vide = désactivé.
ADMIN_ALERT_EMAIL=

# Webhook Resend (bounce/complaint/delivered) — Resend Dashboard > Webhooks >
# Add Endpoint : URL = {APP_URL}/api/comm/webhook/resend, événements
# email.delivered / email.bounced / email.complained / email.delivery_delayed.
# Copier le "Signing Secret" fourni ici. Sans cette clé, le webhook refuse
# toute requête (503) — voir controllers/commWebhookController.js.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback SMTP (si pas de RESEND_API_KEY)
# Gmail  : SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_USER=email  SMTP_PASS=app_password
# Sans SMTP ni Resend → emails simulés dans la console (mode dev uniquement)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Paiements ────────────────────────────────────────────────
# Carte bancaire (Stripe Checkout — webhook signature vérifiée par le SDK)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Wave (webhook HMAC-SHA256 vérifié)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# Orange Money Web Payment (Côte d'Ivoire, Sénégal, Mali, Burkina...) — les 3
# identifiants OAuth + clé marchand sont fournis à l'activation du compte
# marchand sur developer.orange.com. Sans compte réel, le paiement bascule
# automatiquement en mode simulé (voir services/payment/gateway.js).
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_ENV=mp

# ── Stockage images (ImageKit) ──────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── Modules optionnels ────────────────────────────────────────
# Africa's Talking (SMS OTP)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=VIT-AUTO

# Twilio — deux usages distincts, tous deux optionnels :
# 1) Twilio Verify (RECOMMANDÉ pour l'OTP téléphone — gère lui-même la
#    génération/expiration du code) : nécessite en plus un Verify Service SID
#    (créé sur console.twilio.com > Verify > Services).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms
# 2) Envoi SMS "maison" (repli si Twilio Verify n'est pas configuré)
TWILIO_PHONE_FROM=

# WhatsApp Business Cloud API (notifications + bot partenaires entrant)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Chaîne libre que vous choisissez, à renseigner aussi dans le dashboard Meta
# (webhook > Verify Token) lors de la configuration du webhook entrant.
WHATSAPP_VERIFY_TOKEN=
# App Secret Meta (Paramètres de l'app > De base) — vérifie la signature du
# webhook entrant. Laisser vide en dev ; à renseigner en production.
WHATSAPP_APP_SECRET=

# Bot WhatsApp partenaires (Claude/Anthropic)
ANTHROPIC_API_KEY=

# Firebase Cloud Messaging (notifications push)
FCM_SERVER_KEY=

# Connexion Google (inscription/connexion automatique — optionnel) — Client ID
# OAuth "Web application" créé sur https://console.cloud.google.com/apis/credentials.
# Même valeur que VITE_GOOGLE_CLIENT_ID côté frontend (identifiant public, pas
# de secret impliqué dans ce flux de vérification par ID token).
GOOGLE_OAUTH_CLIENT_ID=

# ── Scripts admin (server/scripts/*.js) ─────────────────────────
ADMIN_SEED_EMAIL=admin@vitauto.ci
ADMIN_SEED_PASSWORD=
ADMIN_RESET_PASSWORD=
