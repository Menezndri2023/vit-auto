# ══════════════════════════════════════════════════════════
#  VIT AUTO — Variables d'environnement serveur
#  Copiez ce fichier en .env et remplissez TOUTES les valeurs
# ══════════════════════════════════════════════════════════

# ── Base de données MongoDB ─────────────────────────────
# Format : mongodb+srv://USER:PASSWORD@cluster.mongodb.net/vit-auto
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/vit-auto?retryWrites=true&w=majority

# ── Sécurité JWT ────────────────────────────────────────
# Générez une clé aléatoire FORTE :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REMPLACEZ_PAR_UNE_CLE_ALEATOIRE_FORTE_64_CARACTERES_MINIMUM

# ── URLs ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# ── Serveur ─────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Email SMTP ──────────────────────────────────────────
# Gmail : SMTP_HOST=smtp.gmail.com / PORT=587 / USER=email / PASS=app_password
# SendGrid : SMTP_HOST=smtp.sendgrid.net / USER=apikey / PASS=SG.xxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VIT AUTO <noreply@vitauto.com>
