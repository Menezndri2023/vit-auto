# ══════════════════════════════════════════════════════════════
#  VIT AUTO — Variables d'environnement serveur
#  cp .env.example .env  puis remplissez les valeurs
# ══════════════════════════════════════════════════════════════

# ── Base de données MongoDB ──────────────────────────────────
# Format Atlas : mongodb+srv://USER:PASS@cluster.mongodb.net/vit-auto
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/vit-auto?retryWrites=true&w=majority

# ── Sécurité JWT ─────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REMPLACEZ_PAR_UNE_CLE_FORTE_64_CHARS_MINIMUM

# OBLIGATOIRE pour le refresh token — clé DIFFÉRENTE de JWT_SECRET
REFRESH_TOKEN_SECRET=REMPLACEZ_PAR_UNE_DEUXIEME_CLE_FORTE_64_CHARS

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# ── Serveur ──────────────────────────────────────────────────
PORT=5001
NODE_ENV=development   # production | development

# ── Redis / BullMQ (files d'attente : emails, KYC, PDF, import flotte) ──
# Sans REDIS_URL, les jobs s'exécutent via un fallback synchrone en mémoire
# (voir queue/index.js, SYNC_FALLBACK_LOADERS) — fonctionnel mais sans
# retry/persistance ; fortement recommandé en production pour la fiabilité.
REDIS_URL=

# ── Sentry (suivi d'erreurs) ────────────────────────────────────
SENTRY_DSN=

# ── Email — CAS B : Resend (priorité) → SMTP → Console ──────
# Resend (RECOMMANDÉ) : créer un compte sur resend.com, vérifier votre domaine
# puis coller votre clé API ci-dessous. RESEND_API_KEY a priorité sur SMTP.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=VIT AUTO <noreply@vit-auto.com>

# Fallback SMTP (si pas de RESEND_API_KEY)
# Gmail  : SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_USER=email  SMTP_PASS=app_password
# Sans SMTP ni Resend → emails simulés dans la console (mode dev uniquement)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Paiements ────────────────────────────────────────────────
# ⚠️ Aucune passerelle de paiement n'est réellement branchée dans le code à ce
# jour : les paiements "carte" créent un enregistrement "pending" qui ne
# transite jamais vers "completed"/"failed" (pas de webhook signé). Ces clés
# ne sont donc pas encore consommées par le backend — voir le rapport d'audit.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Orange Money API (Côte d'Ivoire, Sénégal, Mali, Burkina...)
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay

# ── Stockage images (ImageKit) ──────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── Modules optionnels ────────────────────────────────────────
# Africa's Talking (SMS OTP)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=VIT-AUTO

# Twilio (OTP WhatsApp/SMS international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=

# WhatsApp Business Cloud API (notifications)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Firebase Cloud Messaging (notifications push)
FCM_SERVER_KEY=

# Google Maps (adresses auto-complete — optionnel)
GOOGLE_MAPS_API_KEY=

# ── Scripts admin (server/scripts/*.js) ─────────────────────────
ADMIN_SEED_EMAIL=admin@vitauto.ci
ADMIN_SEED_PASSWORD=
ADMIN_RESET_PASSWORD=
