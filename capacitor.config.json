{
  "appId": "com.vitauto.app",
  "appName": "VIT AUTO",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "*.vit-auto.com",
      "*.openstreetmap.org"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0f1b3f",
    "overrideUserAgent": "VIT-AUTO-Android"
  },
  "ios": {
    "backgroundColor": "#0f1b3f",
    "contentInset": "never",
    "overrideUserAgent": "VIT-AUTO-iOS",
    "scheme": "vitauto"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0f1b3f",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "launchShowDuration": 4000
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0f1b3f"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
