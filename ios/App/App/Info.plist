<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>VIT AUTO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>VIT AUTO utilise l'appareil photo pour scanner votre pièce d'identité et prendre votre selfie de vérification (KYC).</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>VIT AUTO utilise votre position pour trouver les véhicules à proximité et estimer les frais de livraison.</string>
	<!-- ITMS-90683 (build 7, 2026-09-19) : le plugin Geolocation de Capacitor
	     référence l'API « toujours », Apple exige la phrase même si l'app ne
	     demande jamais cette autorisation (elle n'utilise la position qu'en
	     cours d'utilisation). -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>VIT AUTO utilise votre position, uniquement pendant l'utilisation de l'app, pour trouver les véhicules à proximité et estimer les frais de livraison.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>VIT AUTO enregistre les photos prises pour votre dossier de vérification.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>VIT AUTO accède à vos photos pour importer vos documents d'identité ou votre selfie de vérification.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
