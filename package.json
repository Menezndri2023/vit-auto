{
  "name": "vit-auto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "kill-port": "kill-port 5001 5173 || true",
    "dev": "npm run kill-port && concurrently -n backend,frontend -c bgBlue.bold,bgGreen.bold --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "cd server && node server.js",
    "dev:only-backend": "cd server && node server.js",
    "dev:only-frontend": "vite",
    "generate-sitemap": "node scripts/generateSitemap.mjs",
    "check:deps-order": "node scripts/checkDependencyArrays.mjs src/",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:server": "cd server && vitest run --maxWorkers=1",
    "prebuild": "npm run generate-sitemap && npm run check:deps-order",
    "build": "vite build",
    "build:mobile": "vite build && npx cap sync",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "verify:local": "node scripts/verifierLocalement.mjs",
    "verify:prod": "node scripts/verifierLocalement.mjs https://vit-auto.com"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@react-oauth/google": "^0.13.5",
    "@sentry/react": "^10.66.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1",
    "socket.io-client": "^4.8.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "kill-port": "^2.0.1",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
